# --- antares-paciente environment variables ---

# Base URL for the backend API (port 5122).
# In dev, Vite proxy handles /api/v1 → http://localhost:5122 automatically.
# For Capacitor native builds, set this to the public HTTPS gateway.
# VITE_API_BASE_URL=https://api.example.com

# Base URL for the Auth Service (port 5123).
# In dev, Vite proxy handles /api/auth → http://localhost:5123 automatically.
# For Capacitor native builds, set this to the public HTTPS gateway.
# VITE_AUTH_BASE_URL=https://auth.example.com

# Feature flag: enable program-progress API integration.
# When "false" or unset, hooks use mock fallback (no network calls).
# Set to "true" to activate server-backed program data.
# VITE_PROGRAM_API_ENABLED=true
