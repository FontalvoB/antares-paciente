# --- antares-paciente environment variables ---

# ÚNICA entrada pública: URL (origen) del API Gateway (YARP, puerto 5080).
# El gateway enruta por prefijo a todos los servicios: /api/auth → Auth,
# /api/v1 → Api, /api/v1/telemedicine y /api/v1/appointments → Telemedicina,
# /api/v1/community y /storage → Comunidad. El WebSocket de la comunidad se
# deriva automáticamente del mismo gateway (ws://<gateway>/api/v1/community/subscriptions).
# En dev web se deja vacío: el proxy de Vite enruta /api y /storage al gateway local.
# En builds nativos (Capacitor) apuntar al gateway público HTTPS.
# VITE_GATEWAY_BASE_URL=https://gateway.coppaddresd.com

# Código de aplicación que identifica este cliente ante el Auth Service
# ("app" para la móvil — default, "erp" para la consola). Determina el
# claim `aud` del JWT y el acceso vía UserApplication.
# VITE_APPLICATION_CODE=app

# Feature flag: enable program-progress API integration.
# When "false" or unset, hooks use mock fallback (no network calls).
# Set to "true" to activate server-backed program data.
# VITE_PROGRAM_API_ENABLED=true

# Feature flag: SOS real (change sos-panic-real). Default "false" (local
# simulation with deliberate double confirmation). Set "true" once the
# backend SOS module is deployed to dispatch POST /api/v1/sos/alerts.
# VITE_SOS_ENABLED=false
