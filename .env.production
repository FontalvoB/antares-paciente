# --- antares-paciente environment (producción / TestFlight) ---
# Build release: `vite build` carga este archivo automáticamente (mode production).
# SÍ versionado: solo variables VITE_* públicas (Vite las incrusta en el bundle).
# NUNCA poner secretos aquí; para dev local usar .env.development (no versionado).

VITE_GATEWAY_BASE_URL=https://erp.coppadresd.com
VITE_APPLICATION_CODE=app
VITE_PROGRAM_API_ENABLED=false

# Web pública (coppadresdWeb, S3 + CloudFront): destino de "Eliminar cuenta" en Perfil.
VITE_WEB_BASE_URL=https://www.coppadresd.com
