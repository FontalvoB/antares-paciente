{
  "name": "antares-paciente",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "build:dev": "tsc -b && vite build --mode development",
    "lint": "oxlint",
    "test": "vitest run",
    "i18n:check": "node scripts/i18n-scan.mjs",
    "preview": "vite preview",
    "sync": "npm run build && npx cap sync && npm run protect:ios-spm",
    "sync:dev": "npm run build:dev && npx cap sync && npm run protect:ios-spm",
    "protect:ios-spm": "node scripts/protect-package-swift.mjs",
    "release:check": "node -e \"const s=require('fs').readFileSync('ios/App/App/Info.plist','utf8'); if(s.includes('NSAllowsArbitraryLoads')||s.includes('NSAllowsLocalNetworking')){console.error('FALLA: Info.plist tiene ATS de desarrollo; revertir antes de archivar.');process.exit(1)} console.log('Info.plist OK para release (sin ATS de desarrollo).')\""
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/camera": "^8.2.4",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/status-bar": "^8.0.3",
    "@elevenlabs/react": "^1.16.0",
    "@ionic/react": "^8.8.18",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@tanstack/react-query": "^5.102.8",
    "framer-motion": "^13.1.0",
    "graphql": "^17.0.2",
    "graphql-ws": "^6.2.1",
    "ionicons": "^8.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-muscle-highlighter": "^1.2.0",
    "react-router-dom": "^7.18.2",
    "three": "0.185.0",
    "urql": "^5.0.3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "^6.0.4",
    "happy-dom": "^20.13.2",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "puppeteer-core": "^25.8.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
