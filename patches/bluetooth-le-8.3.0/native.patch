+        val id = call.getString("deviceId")
+        val owner = call.getString("ownerId")
+        if (id.isNullOrBlank() || owner.isNullOrBlank()) { call.reject("deviceId and ownerId required"); return }
+        try {
+            BleNotificationJournal.get(context).start(id, owner, call.getBoolean("automatic", false) ?: false)
+            BleBackgroundService.start(context)
+            call.resolve()
+        } catch (error: Exception) { call.reject(error.message ?: "Bluetooth background service failed") }
+    }
+
