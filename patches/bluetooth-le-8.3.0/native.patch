+        val id = call.getString("deviceId") ?: run { call.reject("deviceId required"); return }
+        try {
+            BleNotificationJournal.get(context).stop(id, call.getBoolean("forget", false) ?: false)
+            BleBackgroundService.changed(context)
+            call.resolve()
+        } catch (error: Exception) { call.reject(error.message ?: "Bluetooth background stop failed") }
