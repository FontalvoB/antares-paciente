# frozen_string_literal: true

require "base64"

# =============================================================================
# Fastfile — ANTARES Paciente (Ionic + Capacitor 8, iOS)
#
# Flujo completo de release hacia TestFlight:
#   npm run sync (build web + cap sync)  →  match (firma distribución)
#   →  gym (archive Release + IPA)  →  upload_to_testflight
#
# Uso local (requiere haber ejecutado una vez `bundle exec fastlane ios signing`
# con una App Store Connect API Key configurada):
#
#   bundle exec fastlane ios check          # validaciones rápidas
#   bundle exec fastlane ios signing        # crea/renueva cert + profile (match)
#   bundle exec fastlane ios build          # archive + IPA sin subir
#   bundle exec fastlane ios beta           # flujo completo hasta TestFlight
#
# CI: .github/workflows/ios-testflight.yml (Mac + secrets; ver
# docs/IOS_CICD_TESTFLIGHT.md).
# =============================================================================

APP_IDENTIFIER = "com.coppadresd.mobile"
APP_NAME       = "Copp Adresd"
SCHEME         = "App"
PROJECT        = "ios/App/App.xcodeproj"
ROOT           = File.expand_path("..", __dir__)

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

def repo_path(*parts)
  File.join(ROOT, *parts)
end

def apple_team_id
  ENV["APPLE_TEAM_ID"].to_s.empty? ? "XZSSM34MU6" : ENV["APPLE_TEAM_ID"]
end

def asc_key_path
  ENV["APP_STORE_CONNECT_API_KEY_PATH"] ||
    File.join(Dir.home, ".appstoreconnect", "private_keys", "AuthKey_#{ENV['APP_STORE_CONNECT_KEY_ID']}.p8")
end

# Crea el objeto de autenticación contra App Store Connect.
# En CI el .p8 llega por secreto (decodificado a $RUNNER_TEMP); en local se lee
# de ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8 (ruta estándar de fastlane).
def asc_api_key
  %w[APP_STORE_CONNECT_KEY_ID APP_STORE_CONNECT_ISSUER_ID].each do |var|
    UI.user_error!("Falta #{var} (secreto de GitHub Actions o variable de entorno local)") if ENV[var].to_s.empty?
  end
  UI.user_error!("No existe el archivo .p8 en: #{asc_key_path}") unless File.exist?(asc_key_path)

  app_store_connect_api_key(
    key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
    issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
    key_filepath: asc_key_path,
    duration: 1200,
    in_house: false
  )
end

def match_profile_name
  "match AppStore #{APP_IDENTIFIER}"
end

# Credencial de lectura del repo de certificados para `match`.
# Acepta dos formatos en MATCH_GIT_BASIC_AUTHORIZATION:
#   1) base64("usuario:token")  → se usa tal cual (formato original).
#   2) token crudo (github_pat_…/ghp_…) → se codifica solo con MATCH_GIT_USER
#      (default: dueño del repo de certificados).
# Sanea espacios/saltos de línea (pbcopy arrastra un "\n" que provoca 400 en
# GitHub) y devuelve el valor para pasarlo como parámetro explícito a `match`
# (así gana a la env var).
def match_git_basic_authorization
  raw = ENV["MATCH_GIT_BASIC_AUTHORIZATION"].to_s
  return nil if raw.strip.empty?

  clean = raw.gsub(/\s+/, "")

  decoded = begin
    Base64.strict_decode64(clean)
  rescue ArgumentError
    nil
  end
  return clean if decoded&.include?(":")

  user = ENV["MATCH_GIT_USER"].to_s.empty? ? "FontalvoB" : ENV["MATCH_GIT_USER"]
  UI.important("MATCH_GIT_BASIC_AUTHORIZATION no es base64('usuario:token'); se interpreta como token crudo de #{user}.")
  Base64.strict_encode64("#{user}:#{clean}")
end

# Instala certificado + provisioning profile desde el repo de Match.
# - readonly: true (default) solo descarga (CI); el lane `signing` pasa false
#   para crear/renovar. Se puede sobreescribir con MATCH_READONLY.
# - force: recrea los assets aunque existan (rota el certificado; FORCE_SIGNING=1).
def install_signing_assets(api_key, readonly: ENV.fetch("MATCH_READONLY", "true") == "true", force: false)
  if ENV["CI"] == "true" && ENV["MATCH_PASSWORD"].to_s.empty?
    UI.user_error!("MATCH_PASSWORD no configurado (GitHub Secret requerido en CI).")
  end

  match_options = {
    type: "appstore",
    app_identifier: APP_IDENTIFIER,
    team_id: apple_team_id,
    readonly: readonly,
    force: force,
    api_key: api_key
  }
  git_auth = match_git_basic_authorization
  match_options[:git_basic_authorization] = git_auth if git_auth

  match(match_options)
end

# CFBundleVersion = último build en TestFlight + 1 (o BUILD_NUMBER explícito).
# Nunca toca CFBundleShortVersionString.
def next_build_number(api_key)
  override = ENV["BUILD_NUMBER"].to_s.strip
  unless override.empty?
    UI.message("👷 Build number forzado por BUILD_NUMBER=#{override}")
    return Integer(override, 10)
  end

  latest = 0
  begin
    latest = latest_testflight_build_number(
      app_identifier: APP_IDENTIFIER,
      platform: "ios",
      api_key: api_key
    ).to_i
  rescue StandardError => e
    UI.important("No se pudo leer el último build de TestFlight (#{e.class}: #{e.message}); se asume 0.")
  end
  latest + 1
end

# Aplica firma manual (Apple Distribution + profile de Match) SOLO en la copia
# local del pbxproj, con respaldo/restauración para no ensuciar el worktree.
def with_manual_signing
  pbxproj = repo_path(PROJECT, "project.pbxproj")
  backup  = "#{pbxproj}.fastlane-bak"
  FileUtils.cp(pbxproj, backup)
  begin
    update_code_signing_settings(
      use_automatic_signing: false,
      team_id: apple_team_id,
      code_sign_identity: "Apple Distribution",
      profile_name: match_profile_name,
      targets: [SCHEME],
      build_configurations: ["Release"],
      path: repo_path(PROJECT)
    )
    yield
  ensure
    FileUtils.mv(backup, pbxproj) if File.exist?(backup)
  end
end

# Archive Release + export IPA firmado para App Store.
def build_release_ipa(build_number)
  output_dir = repo_path("ios/App/output")
  FileUtils.mkdir_p(output_dir)
  ipa_name = "#{APP_NAME.gsub(' ', '')}-#{build_number}.ipa"

  with_manual_signing do
    build_app(
      project: repo_path(PROJECT),
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      export_team_id: apple_team_id,
      xcargs: "CURRENT_PROJECT_VERSION=#{build_number}",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: { APP_IDENTIFIER => match_profile_name },
        manageAppVersionAndBuildNumber: false,
        uploadSymbols: true,
        uploadBitcode: false,
        stripSwiftSymbols: true
      },
      output_directory: output_dir,
      output_name: ipa_name
    )
  end

  File.join(output_dir, ipa_name)
end

def app_version
  get_version_number(target: SCHEME, xcodeproj: repo_path(PROJECT))
rescue StandardError
  "1.0"
end

# ---------------------------------------------------------------------------
# Lanes
# ---------------------------------------------------------------------------

# Build web + validaciones locales (solo cuando NO llega el dist ya validado
# como artefacto de CI).
def prepare_web!(skip_web_build)
  if skip_web_build
    UI.message("⏭️  skip_web_build: se usa el bundle ya validado (dist/ del job de CI)")
    return
  end
  sh("npm", "run", "sync") # vite build (producción) + npx cap sync
  sh("npm", "run", "lint")
  sh("npm", "test")
  sh("npm", "run", "i18n:check")
end

# Firma + archive + IPA. Devuelve la ruta del .ipa.
def archive_and_export!(api_key, build_number)
  install_signing_assets(api_key)
  ipa = build_release_ipa(build_number)
  UI.success("✅ IPA generado: #{ipa}")
  ipa
end

platform :ios do
  # En CI se usa un keychain temporal (evita prompts "user interaction is not
  # allowed" al importar el certificado de Match).
  before_all do
    setup_ci if ENV["CI"] == "true"
  end

  desc "Validaciones rápidas: lint, tests, i18n y guardas de release (Info.plist)"
  lane :check do
    sh("npm", "run", "lint")
    sh("npm", "test")
    sh("npm", "run", "i18n:check")
    sh("npm", "run", "release:check")
    UI.success("✅ Validaciones locales OK")
  end

  desc "Crea o renueva el certificado 'Apple Distribution' y el profile App Store en el repo de Match"
  lane :signing do
    install_signing_assets(asc_api_key, readonly: false, force: ENV["FORCE_SIGNING"] == "true")
    UI.success("✅ Firma de distribución lista (Match). Profile: #{match_profile_name}")
  end

  desc "Compila, archiva y exporta el IPA firmado SIN subirlo a TestFlight"
  lane :build do |options|
    skip_web_build = options[:skip_web_build] || ENV["FASTLANE_SKIP_WEB_BUILD"] == "true"
    api_key = asc_api_key

    prepare_web!(skip_web_build)
    sh("npm", "run", "release:check") # corta si el ATS de desarrollo sigue en Info.plist

    build_number = next_build_number(api_key)
    UI.message("📱 Versión #{app_version} · Build #{build_number}")
    archive_and_export!(api_key, build_number)
  end

  desc "Flujo completo: build web + sync + firma + archive + IPA + upload a TestFlight"
  lane :beta do |options|
    skip_web_build = options[:skip_web_build] || ENV["FASTLANE_SKIP_WEB_BUILD"] == "true"
    api_key = asc_api_key

    # 1-3) Dependencias + build Ionic + Capacitor sync (en CI el bundle web ya
    #       viene validado como artefacto y se pasa skip_web_build:true).
    prepare_web!(skip_web_build)
    sh("npm", "run", "release:check")

    # 4) Número de build único y creciente (TestFlight + 1 salvo BUILD_NUMBER).
    build_number = next_build_number(api_key)
    UI.message("📱 Versión #{app_version} · Build #{build_number}")

    # 5-7) Firma de distribución + archive Release + IPA.
    ipa = archive_and_export!(api_key, build_number)

    # 8-9) Upload a App Store Connect y publicación en TestFlight.
    groups = ENV["TESTFLIGHT_GROUPS"].to_s.split(",").map(&:strip).reject(&:empty?)
    upload_options = {
      api_key: api_key,
      ipa: ipa,
      skip_waiting_for_build_processing: ENV["WAIT_FOR_PROCESSING"] == "false"
    }
    upload_options[:groups] = groups unless groups.empty?
    upload_options[:changelog] = ENV["TESTFLIGHT_CHANGELOG"] unless ENV["TESTFLIGHT_CHANGELOG"].to_s.empty?
    upload_to_testflight(upload_options)

    UI.success("🚀 Build #{build_number} de la versión #{app_version} subida a TestFlight")
  end
end